{
  if (deriv == "par1") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double theta = std::fmax(par(0), 1e-10), delta = par(1);
      double Pu = std::pow(u1, -theta), Pv = std::pow(u2, -theta);
      double su = std::pow(Pu - 1.0, delta), sv = std::pow(Pv - 1.0, delta);
      double w = std::pow(std::pow(su + sv, 1.0 / delta) + 1.0, -1.0 / theta);
      double Pw = std::pow(w, -theta);
      double t0 = Pw - 1;
      double t1 = 1.0 / theta;
      double t2 = Pu - 1;
      double t3 = -1 / t2;
