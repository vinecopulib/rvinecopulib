      double t0 = 1.0 / u2;
      double t1 = t - 1;
      double t2 = -t1;
      double t3 = std::pow(psi2 * t, theta);
      double t4 = std::pow(psi1 * t2, theta);
      double t5 = t3 + t4;
      double t6 = 1.0 / theta;
      double t7 = std::pow(t5, t6);
      double t8 = t * (1 - psi2) + t2 * (1 - psi1) + t7;
      double t9 = 1.0 / t;
      double t10 =
        psi1 - psi2 + t6 * t7 * (t3 * t9 * theta - t4 * theta / t2) / t5;
      double t11 = t10 * t2 + t8;
      double t12 = std::pow(u2, -2);
      double t13 = -t8;
      double t14 = t * t0 - t0;
      double t15 = 1.0 / r;
      double t16 = 2 * t0 * t14 * t15;
      double t17 = -t * t12 + t12 + t16;
      double t18 = (t14 * t14);
      double t19 = std::pow(-psi1 * t1, theta);
      double t20 = t19 + t3;
      double t21 = 1.0 / t20;
      double t22 = t3 * t9 + t19 / t1;
      double t23 = t21 * (t22 * t22);
      double t24 = t3 / (t * t);
      double t25 = t19 / (t1 * t1);
      double t26 = t24 * theta - t24 + t25 * theta - t25;
      double t27 = -t23 * theta + t23 + t26;
      double t28 = std::pow(t20, t6);
      double t29 = t21 * t28;
      double t30 = t27 * t29;
      double t31 = t15 * t30;
      double t32 = std::pow(t20, -2);
      double t33 = t18 / (r * r);
      double t34 = 1.0 / t11;
      double t35 = t3 / (t * t * t);
      double t36 = 3 * theta;
      double t37 = (theta * theta);
      double t38 = t19 / (t1 * t1 * t1);
      double t39 = (t22 * t22 * t22) * t32;
      double t40 = t21 * t22 * t26;
