      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = t - 1;
      double t1 = -t0;
      double t2 = psi2 * t;
      double t3 = std::pow(t2, theta);
      double t4 = psi1 * t1;
      double t5 = std::pow(t4, theta);
      double t6 = t3 + t5;
      double t7 = 1.0 / theta;
      double t8 = std::pow(t6, t7);
      double t9 = t * (1 - psi2) + t1 * (1 - psi1) + t8;
      double t10 = t3 / (t * t);
      double t11 = t10 * theta;
      double t12 = -psi1 * t0;
      double t13 = std::pow(t12, theta);
      double t14 = t13 / (t0 * t0);
      double t15 = t14 * theta;
      double t16 = t13 + t3;
      double t17 = 1.0 / t16;
      double t18 = 1.0 / t;
      double t19 = t18 * t3;
      double t20 = t13 / t0;
      double t21 = t19 + t20;
      double t22 = (t21 * t21);
      double t23 = t17 * t22;
      double t24 = -t10 + t11 - t14 + t15 - t23 * theta + t23;
      double t25 = std::pow(t16, t7);
      double t26 = t17 * t25;
      double t27 = t24 * t26;
      double t28 = t * t1 / r;
      double t29 = 1.0 / t1;
      double t30 = t29 * t5;
      double t31 = t18 * t3 * theta - t30 * theta;
      double t32 = 1.0 / t6;
      double t33 = t32 * t7;
      double t34 = t33 * t8;
      double t35 = psi1 - psi2 + t31 * t34;
      double t36 = -t * t35 + t9;
      double t37 = t1 * t35 + t9;
      double t38 = t27 * t28 + t36 * t37;
      double t39 = std::pow(theta, -2);
      double t40 = std::log(t2);
      double t41 = t3 * t40;
      double t42 = t5 * std::log(t4);
      double t43 = t41 + t42;
      double t44 = t33 * t43 - t39 * std::log(t6);
      double t45 = t44 * t8;
      double t46 = t31 * t8;
      double t47 =
        t31 * t33 * t45 - t32 * t39 * t46 +
        t34 * (t18 * t3 * t40 * theta + t18 * t3 - t29 * t42 * theta - t30) -
