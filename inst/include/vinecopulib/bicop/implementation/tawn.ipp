      double t18 = psi1 - psi2 + t14 * t17;
      double t19 = t10 + t18 * t2;
      double t20 = std::pow(theta, -2);
      double t21 = std::log(t3);
      double t22 = t21 * t4;
      double t23 = t6 * std::log(t5);
      double t24 = t22 + t23;
      double t25 = t9 * (t16 * t24 - t20 * std::log(t7));
      double t26 = t * t0 - t0;
      double t27 = t14 * t9;
      double t28 =
        t14 * t16 * t25 - t15 * t20 * t27 +
        t17 * (t11 * t21 * t4 * theta + t11 * t4 - t12 * t23 * theta - t13) -
        t24 * t27 * t8 / (t7 * t7);
