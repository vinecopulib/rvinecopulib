  } else if (deriv == "par3u1") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = 1.0 / u1;
      double t1 = t - 1;
      double t2 = -t1;
      double t3 = psi2 * t;
      double t4 = std::pow(t3, theta);
      double t5 = psi1 * t2;
      double t6 = std::pow(t5, theta);
      double t7 = t4 + t6;
      double t8 = 1.0 / theta;
      double t9 = std::pow(t7, t8);
      double t10 = t * (1 - psi2) + t2 * (1 - psi1) + t9;
      double t11 = 1.0 / t;
      double t12 = 1.0 / t2;
      double t13 = t12 * t6;
      double t14 = t11 * t4 * theta - t13 * theta;
      double t15 = 1.0 / t7;
      double t16 = t15 * t8;
      double t17 = t16 * t9;
      double t18 = t * (psi1 - psi2 + t14 * t17);
      double t19 = t10 - t18;
      double t20 = std::pow(theta, -2);
      double t21 = std::log(t3);
      double t22 = t21 * t4;
      double t23 = t6 * std::log(t5);
      double t24 = t22 + t23;
      double t25 = t16 * t24 - t20 * std::log(t7);
      double t26 = t25 * t9;
      double t27 = t14 * t9;
      double t28 =
        t *
        (t14 * t16 * t26 - t15 * t20 * t27 +
         t17 * (t11 * t21 * t4 * theta + t11 * t4 - t12 * t23 * theta - t13) -
         t24 * t27 * t8 / (t7 * t7));
      double t29 = t25 * t9 - t28;
      double t30 = (t * t);
      double t31 = 1.0 / t30;
      double t32 = t31 * t4;
      double t33 = -psi1 * t1;
      double t34 = std::pow(t33, theta);
      double t35 = t34 / (t1 * t1);
      double t36 = t35 * theta;
      double t37 = t34 + t4;
      double t38 = 1.0 / t37;
      double t39 = t34 / t1;
      double t40 = t11 * t4 + t39;
      double t41 = (t40 * t40);
      double t42 = t38 * t41;
      double t43 = t32 * theta - t32 - t35 + t36 - t42 * theta + t42;
      double t44 = std::pow(t37, t8);
      double t45 = t38 * t44;
      double t46 = t43 * t45;
      double t47 = t0 * t30 / r;
      double t48 = std::log(t33);
      double t49 = t22 + t34 * t48;
      double t50 = -t49 / (t37 * t37);
      double t51 = t22 * t31;
      double t52 = t41 * t50;
      double t53 = t38 * t40 * (2 * t11 * t22 + 2 * t39 * t48);
      double t54 = 1.0 / t19;
      double t55 = t47 * t54;
      return t0 * t19 *
             (t0 * t26 - t0 * t28 -
              t55 *
                (t43 * t44 * t50 +
                 t45 * (t32 - t35 * t48 + t35 + t36 * t48 - t42 + t51 * theta -
                        t51 - t52 * theta + t52 - t53 * theta + t53) +
                 t46 * (-t20 * std::log(t37) + t38 * t49 * t8)) +
              (-r * t26 + t29 * t54) * (t0 * t10 - t0 * t18 - t0 - t46 * t55) +
              t29 * t46 * t47 / (t19 * t19)) *
             std::exp(-r * t10);
    };
    return tools_eigen::binaryExpr_or_nan(u, parameters, f);
  } else if (deriv == "u1u1") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = 1.0 / u1;
      double t1 = t - 1;
      double t2 = -t1;
      double t3 = std::pow(psi2 * t, theta);
      double t4 = std::pow(psi1 * t2, theta);
      double t5 = t3 + t4;
      double t6 = 1.0 / theta;
      double t7 = std::pow(t5, t6);
      double t8 = t * (1 - psi2) + t2 * (1 - psi1) + t7;
      double t9 = 1.0 / t;
      double t10 =
        psi1 - psi2 + t6 * t7 * (t3 * t9 * theta - t4 * theta / t2) / t5;
      double t11 = t * t10;
      double t12 = -t11 + t8;
      double t13 = std::pow(u1, -2);
      double t14 = -t8;
      double t15 = 1.0 / r;
      double t16 = t * t13;
      double t17 = 2 * t * t13 * t15 - t16;
      double t18 = (t * t);
      double t19 = std::pow(-psi1 * t1, theta);
      double t20 = t19 + t3;
      double t21 = 1.0 / t20;
      double t22 = t3 * t9 + t19 / t1;
      double t23 = t21 * (t22 * t22);
      double t24 = t3 / t18;
      double t25 = t19 / (t1 * t1);
      double t26 = t24 * theta - t24 + t25 * theta - t25;
      double t27 = -t23 * theta + t23 + t26;
      double t28 = std::pow(t20, t6) * t21;
      double t29 = t27 * t28;
      double t30 = t15 * t29;
      double t31 = std::pow(r, -2);
      double t32 = std::pow(t20, -2);
      double t33 = 1.0 / t12;
      double t34 = t3 / (t * t * t);
      double t35 = 3 * theta;
      double t36 = (theta * theta);
      double t37 = t19 / (t1 * t1 * t1);
      double t38 = (t22 * t22 * t22) * t32;
      double t39 = t21 * t22 * t26;
      return t0 * t12 *
             (-(t * t * t * t) * t13 * std::pow(t20, 2 * t6) * (t27 * t27) *
                t31 * t32 / (t12 * t12) +
              2 * t10 * t15 * t16 - t10 * t17 + t13 * t14 - t13 * t18 * t30 +
              t13 +
              t33 * (-t * t17 * t30 +
                     t13 * t18 * t31 *
                       (-t * t28 *
                          (-t34 * t35 + t34 * t36 + 2 * t34 - t35 * t37 -
                           t35 * t38 - t35 * t39 + t36 * t37 + 2 * t36 * t38 +
                           2 * t37 + t38 + 3 * t39) -
                        t29)) +
              std::pow(-t0 * t11 - t0 * t14 - t0 * t18 * t30 * t33 - t0, 2)) *
             std::exp(-r * t8);
    };
    return tools_eigen::binaryExpr_or_nan(u, parameters, f);
  }
  throw std::runtime_error("unexpected derivative selector: " + deriv);
}

inline Eigen::VectorXd
TawnBicop::hfunc2_deriv_raw(const Eigen::MatrixXd& u,
                            const Eigen::MatrixXd& parameters,
                            const std::string& deriv)
{
  if (deriv == "par1") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = t - 1;
      double t1 = -t0;
      double t2 = std::pow(psi2 * t, theta);
      double t3 = std::pow(psi1 * t1, theta);
      double t4 = t2 + t3;
      double t5 = 1.0 / theta;
      double t6 = std::pow(t4, t5);
      double t7 = t * (1 - psi2) + t1 * (1 - psi1) + t6;
      double t8 = t6 / t4;
      double t9 = t3 * theta / t1;
      double t10 = -t9 + t2 * theta / t;
      double t11 = t10 * t5;
      double t12 = t1 * (psi1 - psi2 + t11 * t8) + t7;
      double t13 = 1.0 / psi1;
      double t14 = t13 * t3;
      double t15 = t0 + t14 * t8;
      double t16 = t14 * t6 / (t4 * t4);
      return t12 *
             (-r * t15 +
              (t1 * (-t10 * t16 + t11 * t16 - t13 * t8 * t9 + 1) + t15) / t12) *
             std::exp(-r * t7) / u2;
    };
    return tools_eigen::binaryExpr_or_nan(u, parameters, f);
  } else if (deriv == "par2") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = 1 - t;
      double t1 = std::pow(psi2 * t, theta);
      double t2 = std::pow(psi1 * t0, theta);
      double t3 = t1 + t2;
      double t4 = 1.0 / theta;
      double t5 = std::pow(t3, t4);
      double t6 = t * (1 - psi2) + t0 * (1 - psi1) + t5;
      double t7 = 1.0 / t3;
      double t8 = t5 * t7;
      double t9 = 1.0 / t;
      double t10 = t1 * t9 * theta - t2 * theta / t0;
      double t11 = t0 * (psi1 - psi2 + t10 * t4 * t8) + t6;
      double t12 = 1.0 / psi2;
      double t13 = t1 * t12;
      double t14 = std::pow(t3, -2);
      return t11 *
             (-r * (-t + t1 * t12 * t5 * t7) +
              (-t +
               t0 *
                 (t1 * t10 * t12 * t14 * t4 * t5 +
                  t1 * t12 * t5 * t7 * t9 * theta - t10 * t13 * t14 * t5 - 1) +
               t13 * t8) /
                t11) *
             std::exp(-r * t6) / u2;
    };
    return tools_eigen::binaryExpr_or_nan(u, parameters, f);
  } else if (deriv == "par3") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = 1 - t;
      double t1 = psi2 * t;
      double t2 = std::pow(t1, theta);
      double t3 = psi1 * t0;
      double t4 = std::pow(t3, theta);
      double t5 = t2 + t4;
      double t6 = 1.0 / theta;
      double t7 = std::pow(t5, t6);
      double t8 = t * (1 - psi2) + t0 * (1 - psi1) + t7;
      double t9 = 1.0 / t;
      double t10 = 1.0 / t0;
      double t11 = t10 * t4;
      double t12 = -t11 * theta + t2 * t9 * theta;
      double t13 = 1.0 / t5;
      double t14 = t13 * t6;
      double t15 = t14 * t7;
      double t16 = t0 * (psi1 - psi2 + t12 * t15) + t8;
      double t17 = std::pow(theta, -2);
      double t18 = std::log(t1);
      double t19 = t4 * std::log(t3);
      double t20 = t18 * t2 + t19;
      double t21 = t7 * (t14 * t20 - t17 * std::log(t5));
      double t22 = t12 * t7;
      return t16 *
             (-r * t21 + (t0 * (t12 * t14 * t21 - t13 * t17 * t22 +
                                t15 * (-t10 * t19 * theta - t11 +
                                       t18 * t2 * t9 * theta + t2 * t9) -
                                t20 * t22 * t6 / (t5 * t5)) +
                          t21) /
                           t16) *
             std::exp(-r * t8) / u2;
    };
    return tools_eigen::binaryExpr_or_nan(u, parameters, f);
  } else if (deriv == "u2") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = 1.0 / u2;
      double t1 = t - 1;
      double t2 = -t1;
      double t3 = std::pow(psi2 * t, theta);
      double t4 = std::pow(psi1 * t2, theta);
      double t5 = t3 + t4;
      double t6 = 1.0 / theta;
      double t7 = std::pow(t5, t6);
      double t8 = t * (1 - psi2) + t2 * (1 - psi1) + t7;
      double t9 = 1.0 / t;
      double t10 =
        psi1 - psi2 + t6 * t7 * (t3 * t9 * theta - t4 * theta / t2) / t5;
      double t11 = t10 * t2 + t8;
      double t12 = t * t0 - t0;
      double t13 = std::pow(-psi1 * t1, theta);
      double t14 = t13 + t3;
      double t15 = 1.0 / t14;
      double t16 = t3 / (t * t);
      double t17 = t13 / (t1 * t1);
      double t18 = t15 * std::pow(t3 * t9 + t13 / t1, 2);
      return t0 * t11 *
             (t0 * t8 - t0 - t10 * t12 +
              t12 * std::pow(t14, t6) * t15 * t2 *
                (t16 * theta - t16 + t17 * theta - t17 - t18 * theta + t18) /
                (r * t11)) *
             std::exp(-r * t8);
    };
    return tools_eigen::binaryExpr_or_nan(u, parameters, f);
  }
  throw std::runtime_error("unexpected derivative selector: " + deriv);
}

inline Eigen::VectorXd
TawnBicop::hfunc2_deriv2_raw(const Eigen::MatrixXd& u,
                             const Eigen::MatrixXd& parameters,
                             const std::string& deriv)
{
  if (deriv == "par1par1") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = t - 1;
      double t1 = -t0;
      double t2 = std::pow(psi2 * t, theta);
      double t3 = psi1 * t1;
      double t4 = std::pow(t3, theta);
      double t5 = t2 + t4;
      double t6 = 1.0 / theta;
      double t7 = std::pow(t5, t6);
      double t8 = t * (1 - psi2) + t1 * (1 - psi1) + t7;
      double t9 = 1.0 / t5;
      double t10 = t7 * t9;
      double t11 = 1.0 / t1;
      double t12 = t4 * theta;
      double t13 = t11 * t12;
      double t14 = -t13 + t2 * theta / t;
      double t15 = t14 * t6;
      double t16 = t1 * (psi1 - psi2 + t10 * t15) + t8;
      double t17 = std::pow(psi1, -2);
      double t18 = t10 * t4;
      double t19 = t17 * t18;
      double t20 = 2 * theta;
      double t21 = std::pow(t3, t20);
      double t22 = std::pow(t5, -2);
      double t23 = t22 * t7;
      double t24 = t17 * t21;
      double t25 = t23 * t24;
      double t26 = t25 * theta;
      double t27 = 1.0 / psi1;
      double t28 = t14 * t23;
      double t29 = t27 * t4;
      double t30 = t15 * t23;
      double t31 = t0 + t18 * t27;
      double t32 = t1 * (-t10 * t13 * t27 - t28 * t29 + t29 * t30 + 1) + t31;
      double t33 = 1.0 / t16;
      double t34 = t10 * t17;
      double t35 = t11 * (theta * theta);
      double t36 = t17 * t28;
      double t37 = t24 * t7 / (t5 * t5 * t5);
      double t38 = t14 * t37;
      return t16 *
             (-r * (t17 * t21 * t22 * t7 + t17 * t4 * t7 * t9 * theta - t19 -
                    t26) +
              t33 * (t1 * (-t11 * t20 * t25 - t12 * t36 + t13 * t34 +
                           t15 * t37 - t17 * t30 * t4 - t19 * t35 + t20 * t38 +
                           2 * t25 * t35 + 2 * t36 * t4 - 3 * t38) +
                     t12 * t34 - t19 + t25 - t26) +
              std::pow(-r * t31 + t32 * t33, 2) - (t32 * t32) / (t16 * t16)) *
             std::exp(-r * t8) / u2;
    };
    return tools_eigen::binaryExpr_or_nan(u, parameters, f);
  } else if (deriv == "par1par2") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = t - 1;
      double t1 = -t0;
      double t2 = std::pow(psi2 * t, theta);
      double t3 = std::pow(psi1 * t1, theta);
      double t4 = t2 + t3;
      double t5 = 1.0 / theta;
