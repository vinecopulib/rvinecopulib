      double t40 = t15 * t8;
      double t41 = psi1 - psi2 + t39 * t40;
      double t42 = t * (1 - psi2) + t3 * (1 - psi1) + t8;
      double t43 = -t * t41 + t42;
      double t44 = t3 * t41 + t42;
      double t45 = t39 * t8;
      double t46 =
        -t13 * t45 * t7 / (t6 * t6) - t14 * t45 * t9 + t15 * t17 * t39 +
        t40 * (t1 * t10 * t26 * theta + t1 * t26 - t12 * t37 * theta - t38);
      double t47 = std::log(t20);
      double t48 = t11 + t21 * t47;
      double t49 = -t48 / (t24 * t24);
      double t50 = t30 * t49;
      double t51 = t25 * t29 * (2 * t10 * t27 + 2 * t28 * t47);
      return -r * t17 + (t36 * (t32 * t33 * t49 +
                                t34 * (-t10 * t18 + t10 * t19 + t18 -
                                       t22 * t47 + t22 + t23 * t47 - t31 -
                                       t50 * theta + t50 - t51 * theta + t51) +
                                t35 * (t25 * t48 * t7 - t9 * std::log(t24))) +
                         t43 * (t17 + t3 * t46) + t44 * (-t * t46 + t16 * t8)) /
                          (t35 * t36 + t43 * t44);
    };
    return tools_eigen::binaryExpr_or_nan(u, parameters, f);
  }
  return AbstractBicop::logpdf_deriv_raw(u, parameters, deriv);
}

inline Eigen::VectorXd
