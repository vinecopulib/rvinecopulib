      double t48 = std::log(t12);
      double t49 = t13 * t48 + t41;
      double t50 = -t49 / (t16 * t16);
      double t51 = t22 * t50;
      double t52 = t17 * t21 * (2 * t19 * t40 + 2 * t20 * t48);
      return t38 *
             (-r * t45 +
              (t28 * (t24 * t25 * t50 +
                      t26 * (-t10 * t40 + t10 + t11 * t40 - t14 * t48 + t14 +
