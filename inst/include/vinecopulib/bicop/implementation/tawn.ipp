      double t14 = std::pow(-psi1 * t1, theta);
      double t15 = t13 * t14;
      double t16 = t15 * theta;
      double t17 = t0 + t14;
      double t18 = 1.0 / t17;
      double t19 = 1.0 / t;
      double t20 = 1.0 / t1;
      double t21 = t14 * t20;
      double t22 = t0 * t19 + t21;
      double t23 = (t22 * t22);
      double t24 = t18 * t23;
      double t25 = t12 * theta - t12 - t15 + t16 - t24 * theta + t24;
      double t26 = std::pow(t17, t6);
      double t27 = t18 * t26;
      double t28 = t * t2 / r;
