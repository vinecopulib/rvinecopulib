      double t4 = std::pow(psi1 * t2, theta);
      double t5 = t3 + t4;
      double t6 = 1.0 / theta;
      double t7 = std::pow(t5, t6);
      double t8 = t * (1 - psi2) + t2 * (1 - psi1) + t7;
