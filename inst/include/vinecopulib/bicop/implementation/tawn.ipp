      double t14 = t * (psi1 - psi2 + t13 * t9);
      double t15 = -t14 + t8;
      double t16 = 1.0 / psi1;
      double t17 = t16 * t4;
      double t18 = t17 * t9;
      double t19 = t1 + t18;
      double t20 = t17 * t7 / (t5 * t5);
      double t21 = t * (-t11 * t16 * t9 - t12 * t20 + t13 * t20 + 1);
      double t22 = 1.0 / r;
      double t23 = (t * t);
      double t24 = std::pow(-psi1 * t1, theta);
      double t25 = t24 + t3;
      double t26 = 1.0 / t25;
      double t27 = std::pow(t25, t6);
      double t28 = t3 / t23;
      double t29 = std::pow(t1, -2);
      double t30 = t24 * t29;
      double t31 = t30 * theta;
      double t32 = 1.0 / t1;
      double t33 = t24 * t32;
      double t34 = t10 * t3 + t33;
      double t35 = (t34 * t34);
      double t36 = t26 * t35;
      double t37 = t28 * theta - t28 - t30 + t31 - t36 * theta + t36;
      double t38 = t + t18 - t21 - 1;
      double t39 = t16 * t2;
      double t40 = std::pow(t25, -2);
      double t41 = t33 * t40;
      double t42 = t27 * t37 * t41;
      double t43 = std::pow(t1, -3);
      double t44 = (theta * theta);
      double t45 = t39 * t44;
      double t46 = t26 * t27;
      double t47 = 1.0 / t15;
      double t48 = t0 * t22 * t23 * t47;
      return t0 * t15 *
             (t0 * t19 - t0 * t21 +
              t0 * t22 * t23 * t26 * t27 * t37 * t38 / (t15 * t15) -
              t48 * (t39 * t42 * theta - t39 * t42 +
                     t46 * (2 * t16 * t2 * t24 * t26 * t29 * t34 * t44 +
                            t16 * t2 * t24 * t32 * t35 * t40 * theta +
                            t16 * t2 * t24 * t43 * theta - t24 * t43 * t45 -
                            2 * t26 * t31 * t34 * t39 - t35 * t41 * t45)) +
              (-r * t19 + t38 * t47) *
                (-t0 * t14 + t0 * t8 - t0 - t37 * t46 * t48)) *
