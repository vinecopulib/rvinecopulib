      double t35 = t34 * theta;
      double t36 = t33 + t4;
      double t37 = 1.0 / t36;
      double t38 = t33 / t1;
      double t39 = t11 * t4 + t38;
      double t40 = (t39 * t39);
      double t41 = t37 * t40;
      double t42 = t31 * theta - t31 - t34 + t35 - t41 * theta + t41;
      double t43 = std::pow(t36, t8);
      double t44 = t37 * t43;
      double t45 = t42 * t44;
      double t46 = 1.0 / r;
      double t47 = t2 * t26 * t46;
      double t48 = std::log(t32);
      double t49 = t22 + t33 * t48;
      double t50 = -t49 / (t36 * t36);
      double t51 = t22 * t30;
      double t52 = t40 * t50;
