             (t28 * (t27 * (2 * t13 * t14 * t18 * t2 * t22 * t43 * t9 +
                            t14 * t2 * t20 * t23 * t39 * t9 * theta +
                            t14 * t2 * t42 * t9 * theta - t14 * t42 * t44 -
                            2 * t16 * t18 * t22 * t38 - t23 * t40 * t44) +
                     t38 * t41 * theta - t38 * t41) +
              t34 * (t11 + t2 * t37) +
