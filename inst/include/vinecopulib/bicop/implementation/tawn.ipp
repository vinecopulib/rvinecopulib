    };
    return tools_eigen::binaryExpr_or_nan(u, parameters, f);
  } else if (deriv == "par2u1") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = 1.0 / u1;
      double t1 = t - 1;
      double t2 = -t1;
      double t3 = std::pow(psi2 * t, theta);
      double t4 = std::pow(psi1 * t2, theta);
      double t5 = t3 + t4;
      double t6 = 1.0 / theta;
      double t7 = std::pow(t5, t6);
      double t8 = t * (1 - psi2) + t2 * (1 - psi1) + t7;
      double t9 = 1.0 / t5;
      double t10 = 1.0 / t;
      double t11 = t10 * t3 * theta - t4 * theta / t2;
      double t12 = t * (psi1 - psi2 + t11 * t6 * t7 * t9);
      double t13 = -t12 + t8;
      double t14 = 1.0 / psi2;
      double t15 = t - t14 * t3 * t7 * t9;
      double t16 = std::pow(t5, -2);
      double t17 = t14 * t3;
      double t18 =
        t * (t10 * t14 * t3 * t7 * t9 * theta + t11 * t14 * t16 * t3 * t6 * t7 -
             t11 * t16 * t17 * t7 - 1);
      double t19 = 1.0 / r;
      double t20 = (t * t);
      double t21 = std::pow(-psi1 * t1, theta);
      double t22 = t21 + t3;
      double t23 = 1.0 / t22;
      double t24 = std::pow(t22, t6);
      double t25 = t3 / t20;
      double t26 = t25 * theta;
      double t27 = t21 / (t1 * t1);
      double t28 = t10 * t3;
      double t29 = t28 + t21 / t1;
      double t30 = (t29 * t29);
      double t31 = t23 * t30;
      double t32 = -t25 + t26 + t27 * theta - t27 - t31 * theta + t31;
      double t33 = -t15 - t18;
      double t34 = t17 / (t22 * t22);
      double t35 = t24 * t32 * t34;
      double t36 = (theta * theta);
      double t37 = t14 * t36;
      double t38 = t30 * t34;
      double t39 = 2 * t23 * t29;
      double t40 = t23 * t24;
      double t41 = 1.0 / t13;
      double t42 = t0 * t19 * t20 * t41;
      return t0 * t13 *
             (-t0 * t15 - t0 * t18 +
              t0 * t19 * t20 * t23 * t24 * t32 * t33 / (t13 * t13) -
              t42 * (-t35 * theta + t35 +
                     t40 * (-t14 * t26 + t14 * t28 * t39 * theta + t25 * t37 -
                            t28 * t37 * t39 + t36 * t38 - t38 * theta)) +
              (r * t15 + t33 * t41) *
                (-t0 * t12 + t0 * t8 - t0 - t32 * t40 * t42)) *
             std::exp(-r * t8);
    };
