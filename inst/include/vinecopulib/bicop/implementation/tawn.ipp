      double t20 = t14 * t19;
      double t21 = -t11 + t12 - t20 * theta + t20 + t8 * theta - t8;
      double t22 = std::pow(t13, t5);
      double t23 = t14 * t22;
      double t24 = t * t1 / r;
      double t25 = 1.0 / t4;
      double t26 = t25 * t6;
      double t27 = t3 * theta / t1;
      double t28 = t15 * t2 * theta - t27;
      double t29 = t28 * t5;
      double t30 = psi1 - psi2 + t26 * t29;
      double t31 = -t * t30 + t7;
      double t32 = t1 * t30 + t7;
      double t33 = t21 * t23 * t24 + t31 * t32;
      double t34 = 1.0 / psi1;
      double t35 = t3 * t34;
      double t36 = t0 + t26 * t35;
      double t37 = t35 * t6 / (t4 * t4);
      double t38 = -t26 * t27 * t34 - t28 * t37 + t29 * t37 + 1;
      double t39 = t1 * t34;
      double t40 = std::pow(t13, -2);
      double t41 = t17 * t40;
