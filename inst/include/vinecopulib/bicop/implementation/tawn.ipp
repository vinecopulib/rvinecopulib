}

inline Eigen::VectorXd
TawnBicop::pdf_deriv2_raw(const Eigen::MatrixXd& u,
                          const Eigen::MatrixXd& parameters,
                          const std::string& deriv)
{
  if (deriv == "par1par1") {
    auto f = [](const double& u1,
                const double& u2,
                const Eigen::Ref<const Eigen::VectorXd>& par) {
      double psi1 = std::fmax(par(0), 1e-10), psi2 = std::fmax(par(1), 1e-10),
             theta = par(2);
      double r = -std::log(u1 * u2);
      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = t - 1;
      double t1 = -t0;
      double t2 = std::pow(psi2 * t, theta);
      double t3 = psi1 * t1;
      double t4 = std::pow(t3, theta);
      double t5 = t2 + t4;
      double t6 = 1.0 / theta;
      double t7 = std::pow(t5, t6);
      double t8 = t * (1 - psi2) + t1 * (1 - psi1) + t7;
      double t9 = t2 / (t * t);
      double t10 = std::pow(t0, -2);
      double t11 = -psi1 * t0;
      double t12 = std::pow(t11, theta);
      double t13 = t10 * t12;
      double t14 = t13 * theta;
      double t15 = t12 + t2;
      double t16 = 1.0 / t15;
      double t17 = 1.0 / t;
      double t18 = 1.0 / t0;
      double t19 = t12 * t18;
      double t20 = t17 * t2 + t19;
      double t21 = (t20 * t20);
      double t22 = t16 * t21;
      double t23 = -t13 + t14 - t22 * theta + t22 + t9 * theta - t9;
      double t24 = std::pow(t15, t6);
      double t25 = t16 * t24;
      double t26 = t * t1 / r;
      double t27 = 1.0 / t5;
      double t28 = t27 * t7;
      double t29 = 1.0 / t1;
      double t30 = t4 * theta;
      double t31 = t29 * t30;
      double t32 = t17 * t2 * theta - t31;
      double t33 = t32 * t6;
      double t34 = psi1 - psi2 + t28 * t33;
      double t35 = -t * t34 + t8;
      double t36 = t1 * t34 + t8;
      double t37 = t23 * t25 * t26 + t35 * t36;
      double t38 = std::pow(psi1, -2);
      double t39 = t28 * t4;
      double t40 = t38 * t39;
      double t41 = 2 * theta;
      double t42 = std::pow(t3, t41);
      double t43 = std::pow(t5, -2);
      double t44 = t43 * t7;
      double t45 = t38 * t42;
      double t46 = t44 * t45;
      double t47 = t46 * theta;
      double t48 =
        -t27 * t38 * t4 * t7 * theta - t38 * t42 * t43 * t7 + t40 + t47;
      double t49 = 1.0 / psi1;
      double t50 = t32 * t44;
      double t51 = t4 * t49;
      double t52 = t33 * t44;
      double t53 = -t28 * t31 * t49 - t50 * t51 + t51 * t52 + 1;
      double t54 = t0 + t39 * t49;
      double t55 = t1 * t53 + t54;
      double t56 = -t * t53 + t + t27 * t4 * t49 * t7 - 1;
      double t57 = t1 * t49;
      double t58 = std::pow(t15, -2);
      double t59 = t19 * t58;
      double t60 = t23 * t24;
      double t61 = t59 * t60;
      double t62 = std::pow(t0, -3);
      double t63 = (theta * theta);
      double t64 = t12 * t62;
      double t65 = t41 * t57;
      double t66 = t13 * t20;
      double t67 = t21 * t59;
      double t68 = 2 * t1 * t10 * t12 * t16 * t20 * t49 * t63 +
