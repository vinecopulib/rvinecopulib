      double t = std::log(u2) / std::log(u1 * u2);
      double t0 = t - 1;
      double t1 = -t0;
      double t2 = std::pow(psi2 * t, theta);
      double t3 = std::pow(psi1 * t1, theta);
      double t4 = t2 + t3;
      double t5 = 1.0 / theta;
      double t6 = std::pow(t4, t5);
      double t7 = t * (1 - psi2) + t1 * (1 - psi1) + t6;
      double t8 = t2 / (t * t);
      double t9 = std::pow(t0, -2);
      double t10 = std::pow(-psi1 * t0, theta);
