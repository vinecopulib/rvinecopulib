      double t21 = std::pow(t20, theta);
      double t22 = t21 / (t2 * t2);
      double t23 = t22 * theta;
      double t24 = t1 + t21;
      double t25 = 1.0 / t24;
      double t26 = 1.0 / t;
      double t27 = t1 * t26;
      double t28 = t21 / t2;
      double t29 = t27 + t28;
      double t30 = (t29 * t29);
      double t31 = t25 * t30;
      double t32 = -t18 + t19 - t22 + t23 - t31 * theta + t31;
      double t33 = std::pow(t24, t7);
      double t34 = t25 * t33;
      double t35 = t32 * t34;
      double t36 = t * t3 / r;
      double t37 = 1.0 / t3;
      double t38 = t37 * t5;
