      double t33 = t * (1 - psi2) + t2 * (1 - psi1) + t7;
      double t34 = -t * t32 + t33;
      double t35 = t2 * t32 + t33;
      double t36 = t10 * t7 / (t4 * t4);
      double t37 = -t29 * t8 * t9 - t30 * t36 + t31 * t36 + 1;
      double t38 = t2 * t9;
      double t39 = std::pow(t17, -2);
      double t40 = t21 * t39;
      double t41 = t25 * t26 * t40;
      double t42 = std::pow(t1, -3);
      double t43 = (theta * theta);
      double t44 = t38 * t43;
