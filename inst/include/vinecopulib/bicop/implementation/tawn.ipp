             (t10 * t16 - t10 * t17 + t12 * t13 + t12 - t18 * t31 +
              t34 * (t17 * t2 * t31 +
                     t33 * (t2 * t29 *
                              (-t35 * t36 + t35 * t37 + 2 * t35 - t36 * t38 -
                               t36 * t39 - t36 * t40 + t37 * t38 +
                               2 * t37 * t39 + 2 * t38 + t39 + 3 * t40) -
                            t30)) +
              std::pow(-t0 * t13 - t0 - t10 * t14 +
                         t14 * t15 * t2 * t21 * t27 * t28 * t34,
                       2) -
              (t2 * t2) * std::pow(t20, 2 * t6) * (t27 * t27) * t32 * t33 /
